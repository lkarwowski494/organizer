{
  "name": "organizer",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible-next": "0.4.1",
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@react-navigation/bottom-tabs": "7.20.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "@supabase/supabase-js": "2.117.2",
    "babel-preset-expo": "~57.0.0",
    "eslint-config-expo": "~57.0.2",
    "expo": "~57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "57.0.3",
    "expo-calendar": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-notifications": "57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@testing-library/react-native": "14.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/jest": "29.5.14",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "~19.2.2",
    "better-sqlite3": "13.0.3",
    "deno": "2.9.6",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "pg": "8.23.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:domain": "jest --selectProjects domain",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run check:functions && npm run check:corpus",
    "check:functions": "deno check supabase/functions && deno lint supabase/functions && deno test --no-prompt supabase/functions",
    "check:corpus": "python3 -I scripts/gen-quickadd-corpus.py 2>/dev/null | diff -q - src/domain/__tests__/fixtures/quickadd.pl.json && python3 -I scripts/gen-contrast-corpus.py | diff -q - src/domain/__tests__/fixtures/contrast.json",
    "test:mutation": "stryker run",
    "test:coverage": "jest --coverage",
    "check:audit": "node scripts/audit-check.mjs",
    "test:db": "bash scripts/db/test-db.sh && PGHOST=${PGHOST:-/tmp} PGPORT=${PGPORT:-54329} PGUSER=${PGUSER:-postgres} jest --selectProjects db",
    "e2e:check": "scripts/e2e/check-flows.sh",
    "e2e:build": "scripts/e2e/build-ios.sh",
    "e2e:run": "scripts/e2e/run-flows.sh",
    "e2e:compare": "node scripts/e2e/compare-screenshots.mjs --baselines .maestro/baselines --actual e2e-artifacts/screenshots --out e2e-artifacts/diff",
    "e2e:accept": "scripts/e2e/accept-baselines.sh"
  },
  "private": true
}
