{
  "name": "organizer",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "eslint-config-expo": "~57.0.2",
    "expo": "~57.0.26",
    "expo-crypto": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "deno": "2.9.6",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:domain": "jest --selectProjects domain",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run check:functions && npm run check:corpus",
    "check:functions": "deno check supabase/functions && deno lint supabase/functions",
    "check:corpus": "python3 -I scripts/gen-quickadd-corpus.py 2>/dev/null | diff -q - src/domain/__tests__/fixtures/quickadd.pl.json",
    "test:mutation": "stryker run",
    "test:coverage": "jest --coverage",
    "check:audit": "node scripts/audit-check.mjs"
  },
  "private": true
}
