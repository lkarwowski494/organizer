{
  "expo": {
    "name": "Organizer",
    "slug": "organizer",
    "scheme": "io.github.lkarwowski494.organizer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "io.github.lkarwowski494.organizer",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.io.github.lkarwowski494.organizer"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "pl",
        "CFBundleLocalizations": [
          "pl"
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Organizer dodaje wybrane wydarzenia do Twojego kalendarza. Nie odczytuje kalendarza.",
          "calendarPermission": false,
          "remindersPermission": false
        }
      ]
    ]
  }
}
