{
  "expo": {
    "name": "Organizer",
    "slug": "organizer",
    "scheme": "io.github.lkarwowski494.organizer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "io.github.lkarwowski494.organizer",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.io.github.lkarwowski494.organizer"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "pl",
        "CFBundleLocalizations": [
          "pl"
        ],
        "NSCalendarsWriteOnlyAccessUsageDescription": "Organizer dodaje wybrane wydarzenia do Twojego kalendarza. Nie odczytuje kalendarza."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "writeOnlyAccess": false,
          "calendarPermission": "Organizer pokazuje Twoje wydarzenia z kalendarza obok spraw grup i dodaje wydarzenia grup do osobnych kalendarzy „Organizer”. Twoje wydarzenia nie opuszczają telefonu.",
          "remindersPermission": "Organizer nie korzysta z Przypomnień."
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ]
    ]
  }
}
