# Build i wysyłka do TestFlight z CI (D9, D28, D29). Uruchamiane tylko w workflow w środowisku ios-release
# (gałąź main i tagi v*, bez zatwierdzania — D53). Klucz App Store Connect API: zespołowy, rola App Manager.
# Dokumentacja: https://docs.fastlane.tools/actions/match/ ,
# https://docs.fastlane.tools/actions/app_store_connect_api_key/ , https://docs.fastlane.tools/actions/setup_ci/

default_platform(:ios)

APP_ID = "io.github.lkarwowski494.organizer"
WORKSPACE = "ios/Organizer.xcworkspace"
PROJECT = "ios/Organizer.xcodeproj"
SCHEME = "Organizer"

platform :ios do
  private_lane :asc_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      in_house: false
    )
  end

  # Jednorazowo: tworzy certyfikat dystrybucyjny i profil App Store w organizer-certs.
  lane :bootstrap_signing do
    setup_ci
    match(api_key: asc_key, readonly: false)
  end

  lane :release do
    setup_ci # tymczasowy keychain; przełącza match w tryb tylko do odczytu
    api_key = asc_key
    match(api_key: api_key, readonly: true)
    increment_build_number(xcodeproj: PROJECT, build_number: ENV.fetch("BUILD_NUMBER"))
    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: "8NQ9GHY8GF",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{APP_ID}",
      bundle_identifier: APP_ID
    )
    build_app(workspace: WORKSPACE, scheme: SCHEME, configuration: "Release", export_method: "app-store",
              output_directory: "build", clean: true)
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
